{
  "name": "shifter-proxy-extension",
  "description": "Shifter browser extension: browse through your Shifter Residential & ISP proxies.",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:mock": "WXT_USE_MOCK=true wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:mock": "WXT_USE_MOCK=true wxt build",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "icons": "node scripts/build-icons.mjs",
    "postinstall": "wxt prepare",
    "preview:ui": "WXT_USE_MOCK=true wxt build && node scripts/preview.mjs",
    "geo:catalog": "node scripts/build-geo-catalog.mjs",
    "e2e": "cd e2e && npm test --"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  }
}
